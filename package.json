{
  "name": "jadwal-mengajar-app",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "build": {
    "appId": "id.sch.jadwal.kurikulum",
    "productName": "Jadwal Mengajar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      ".next/standalone/**/*",
      "public/**/*",
      "prisma/schema.prisma"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jadwal Mengajar"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma db push --skip-generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "compile:electron": "tsc electron/main.ts --outDir dist-electron --module commonjs --target es2020 --esModuleInterop --skipLibCheck",
    "prepare:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-standalone.ps1",
    "dist": "npm run build && npm run compile:electron && npm run prepare:standalone && electron-builder"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "date-fns": "^3.3.1",
    "jose": "^5.2.2",
    "lucide-react": "^0.344.0",
    "next": "14.1.0",
    "nodemailer": "^6.9.10",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8",
    "prisma": "^5.10.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
