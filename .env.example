# Salin file ini menjadi `.env` di server, lalu isi nilainya. JANGAN commit .env.

# Wajib: string acak panjang untuk menandatangani login. Buat dengan:
#   openssl rand -base64 48
JWT_SECRET=

# Akun admin pertama (dibuat otomatis saat login pertama jika database masih kosong)
ADMIN_EMAIL=admin@sekolah.sch.id
ADMIN_PASSWORD=

# Isi false HANYA jika diakses lewat HTTP biasa (tanpa HTTPS), mis. http://IP:3000
# COOKIE_SECURE=false

# Opsional (fitur email)
EMAIL_USER=
EMAIL_PASS=

# Hanya untuk jalan tanpa Docker (di Docker sudah diatur otomatis ke /data/app.db)
# DATABASE_URL=file:./prod.db
